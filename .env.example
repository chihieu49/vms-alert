# ==============================================================================
# HỆ THỐNG GIÁM SÁT TÀU CÁ CHUYÊN DỤNG (VMS ALERT SYSTEM)
# CẤU HÌNH MÔI TRƯỜNG (.env)
# ==============================================================================

# 1. API GIÁM SÁT TỔNG CỤC THỦY SẢN
GSTC_API_URL=https://gstc.tongcucthuysan.gov.vn/Map/exportdanhsachtau?exportFields=latitude%26longitude%26time%26ship_state%26distanceToboundy%26agency%26deviceId%26serial%26imei%26shipName%26ownerName%26captainName%26plate_number%26captainAddress%26ownerAddress%26captainPhone%26ownerPhone%26businessName%26chieudaitoanbo%26congsuat&sign=56ef085f11644f96b6b5f6200f71197c&ship_state=&state_kind=
GSTC_COOKIE=
USE_MOCK_DATA=false

# 2. CHU KỲ QUÉT & NGƯỠNG MẤT TÍN HIỆU (PHÚT)
POLL_INTERVAL_MINUTES=120
LOST_SIGNAL_THRESHOLD_MINUTES=120
MIN_VESSEL_LENGTH_METERS=15.0

# 3. KÊNH THÔNG BÁO EMAIL (BẮT BUỘC)
ADMIN_EMAIL=adminnhvn@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Trạm Kiểm Ngư Ninh Hòa - Vạn Ninh - Giám Sát VMS"

# 4. KÊNH THÔNG BÁO MỞ RỘNG (TÙY CHỌN: TELEGRAM / ZALO OA / SMS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_OA_ACCESS_TOKEN=
SMS_API_KEY=

# 5. CƠ SỞ DỮ LIỆU & MÁY CHỦ WEB
DATABASE_URL=sqlite:///./data/vms_alert.db
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# 6. BẢO MẬT & XÁC THỰC NGƯỜI DÙNG (JWT + COOKIE HTTPONLY)
SECRET_KEY=vms-nhvn-2026-secure-jwt-key-khanh-hoa-fishery-999
ACCESS_TOKEN_EXPIRE_HOURS=8
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin@nhvn2026

